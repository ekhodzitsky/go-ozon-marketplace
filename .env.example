# ============================================
# go-ozon-marketplace — environment variables
# ============================================
# Each service runs in its own container/pod and reads the variables
# below from its own environment. When running multiple services locally
# from a single shell, export the variables per service or use separate
# terminal sessions to avoid collisions (e.g. GRPC_PORT).

# Shared secrets (required for all services)
JWT_SECRET=change-me-in-production-min-32-chars-long

# --------------------------------------------
# User Service (defaults: gRPC 50051, HTTP 8080, metrics 60051)
# --------------------------------------------
GRPC_PORT=50051
HTTP_PORT=8080
METRICS_PORT=60051
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/users?sslmode=disable
BCRYPT_COST=12
ENABLE_ARGON2ID=true
CERT_PATH=

# --------------------------------------------
# Catalog Service (defaults: gRPC 50052, metrics 60052)
# --------------------------------------------
# GRPC_PORT=50052
# METRICS_PORT=60052
# POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/catalog?sslmode=disable
ES_URL=http://localhost:9200
CERT_PATH=

# --------------------------------------------
# Inventory Service (defaults: gRPC 50053, metrics 60053)
# --------------------------------------------
# GRPC_PORT=50053
# METRICS_PORT=60053
# POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/inventory?sslmode=disable
REDIS_ADDR=localhost:6379
CERT_PATH=

# --------------------------------------------
# Payment Service (defaults: gRPC 50054, metrics 60054)
# --------------------------------------------
# GRPC_PORT=50054
# METRICS_PORT=60054
# POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/payments?sslmode=disable
CERT_PATH=

# --------------------------------------------
# Order Service (defaults: gRPC 50055, metrics 60055)
# --------------------------------------------
# GRPC_PORT=50055
# METRICS_PORT=60055
# POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/orders?sslmode=disable
INVENTORY_ADDR=localhost:50053
PAYMENT_ADDR=localhost:50054
CERT_PATH=

# --------------------------------------------
# Notification Service (defaults: gRPC 50056, metrics 60056)
# --------------------------------------------
# GRPC_PORT=50056
# METRICS_PORT=60056
CERT_PATH=

# --------------------------------------------
# Analytics Service (defaults: gRPC 50057, metrics 60057)
# --------------------------------------------
# GRPC_PORT=50057
# METRICS_PORT=60057
CLICKHOUSE_DSN=localhost:9000
CERT_PATH=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TLS=false

# --------------------------------------------
# API Gateway (default: HTTP 8080)
# --------------------------------------------
PORT=8080
USER_SERVICE_ADDR=localhost:50051
CATALOG_SERVICE_ADDR=localhost:50052
CERT_PATH=
RATE_LIMIT_RPS=10
ENABLE_INTROSPECTION=false
MAX_PAGE_SIZE=100
GRAPHQL_COMPLEXITY_LIMIT=200
GRAPHQL_MAX_DEPTH=10
