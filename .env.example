# ============================================
# go-ozon-marketplace — environment variables
# ============================================

# Shared secrets (required for docker-compose.dev.yml and all services)
JWT_SECRET=min-32-chars-secret-key-here!!!!

# Infrastructure endpoints (used by seed scripts and local runs)
POSTGRES_DSN=postgres://ozon:ozonpass@localhost:5432/marketplace?sslmode=disable
REDIS_ADDR=localhost:6379
ES_URL=http://localhost:9200
CLICKHOUSE_DSN=localhost:9000
KAFKA_BROKERS=localhost:9092

# --------------------------------------------
# User Service (defaults: gRPC 50051, HTTP 8080, metrics 60051)
# --------------------------------------------
GRPC_PORT=50051
HTTP_PORT=8080
METRICS_PORT=60051
BCRYPT_COST=12
ENABLE_ARGON2ID=true
CERT_PATH=

# --------------------------------------------
# Catalog Service (defaults: gRPC 50052, metrics 60052)
# --------------------------------------------
# GRPC_PORT=50052
# METRICS_PORT=60052
CERT_PATH=

# --------------------------------------------
# Inventory Service (defaults: gRPC 50053, metrics 60053)
# --------------------------------------------
# GRPC_PORT=50053
# METRICS_PORT=60053
CERT_PATH=

# --------------------------------------------
# Payment Service (defaults: gRPC 50054, metrics 60054)
# --------------------------------------------
# GRPC_PORT=50054
# METRICS_PORT=60054
CERT_PATH=

# --------------------------------------------
# Order Service (defaults: gRPC 50055, metrics 60055)
# --------------------------------------------
# GRPC_PORT=50055
# METRICS_PORT=60055
INVENTORY_ADDR=localhost:50053
PAYMENT_ADDR=localhost:50054
CATALOG_ADDR=localhost:50052
CERT_PATH=

# --------------------------------------------
# Notification Service (defaults: gRPC 50056, metrics 60056)
# --------------------------------------------
# GRPC_PORT=50056
# METRICS_PORT=60056
CERT_PATH=

# --------------------------------------------
# Analytics Service (defaults: gRPC 50057, metrics 60057)
# --------------------------------------------
# GRPC_PORT=50057
# METRICS_PORT=60057
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TLS=false
CERT_PATH=

# --------------------------------------------
# API Gateway (default: HTTP 8080)
# --------------------------------------------
PORT=8080
USER_SERVICE_ADDR=localhost:50051
CATALOG_SERVICE_ADDR=localhost:50052
ORDER_SERVICE_ADDR=localhost:50055
INVENTORY_SERVICE_ADDR=localhost:50053
PAYMENT_SERVICE_ADDR=localhost:50054
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_INTROSPECTION=false
CORS_ALLOWED_ORIGINS=*
