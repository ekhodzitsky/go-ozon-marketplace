type User {
  id: ID!
  email: String!
  name: String!
  createdAt: String!
}

type Product {
  id: ID!
  name: String!
  description: String!
  price: Float!
  categories: [String!]!
  createdAt: String!
}

type ProductConnection {
  products: [Product!]!
  total: Int!
}

type OrderItem {
  productId: ID!
  quantity: Int!
  price: Float!
}

type Order {
  id: ID!
  userId: ID!
  items: [OrderItem!]!
  totalAmount: Float!
  status: String!
  createdAt: String!
  updatedAt: String!
}

type OrderConnection {
  orders: [Order!]!
  total: Int!
}

type Inventory {
  productId: ID!
  available: Int!
  reserved: Int!
}

input OrderItemInput {
  productId: ID!
  quantity: Int!
  price: Float!
}

type FeatureFlags {
  newCheckoutFlow: Boolean!
  fastSearch: Boolean!
  discountSystem: Boolean!
  realTimeUpdates: Boolean!
}

type ABTestAssignment {
  experiment: String!
  variation: String!
}

type Query {
  me: User
  user(id: ID!): User
  product(id: ID!): Product
  searchProducts(query: String!, page: Int, pageSize: Int): ProductConnection
  order(id: ID!): Order
  orders(userId: ID!, page: Int, pageSize: Int): OrderConnection
  inventory(productId: ID!): Inventory
  featureFlags: FeatureFlags!
  abTestAssignments(userId: ID!): [ABTestAssignment!]!
}

type Mutation {
  register(email: String!, password: String!, name: String!): ID!
  login(email: String!, password: String!): String!
  createProduct(name: String!, description: String!, price: Float!, categories: [String!]!): ID!
  createOrder(items: [OrderItemInput!]!): ID!
  cancelOrder(orderId: ID!): Boolean!
}

type Subscription {
  orderStatusChanged(userId: ID!): Order
  inventoryChanged(productId: ID!): Inventory
}
