{
  "id": null,
  "uid": "infrastructure",
  "title": "Infrastructure",
  "tags": ["infra", "k8s", "db"],
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "CPU Usage by Pod",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(container_cpu_usage_seconds_total[1m])",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {"drawStyle": "line"}
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Memory Usage by Pod",
      "type": "timeseries",
      "targets": [
        {
          "expr": "container_memory_usage_bytes",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {"drawStyle": "line"}
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "DB Connections Active",
      "type": "timeseries",
      "targets": [
        {
          "expr": "db_connections_active",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line"}
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Redis Hit Ratio",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[1m]) / (rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m]))",
          "legendFormat": "hit ratio",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {"drawStyle": "line"}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Kafka Consumer Lag",
      "type": "timeseries",
      "targets": [
        {
          "expr": "kafka_consumer_group_lag",
          "legendFormat": "{{topic}} / {{consumer_group}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"drawStyle": "line"}
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "ClickHouse Insert Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(clickhouse_profile_events_insert[1m])",
          "legendFormat": "inserts/s",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"drawStyle": "line"}
        },
        "overrides": []
      }
    }
  ]
}
